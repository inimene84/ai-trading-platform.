    {
      "parameters": {
        "jsCode": "function extractHits(j) {\n  const hits = [];\n  const pools = [];\n  if (!j || typeof j !== 'object') return hits;\n  if (Array.isArray(j.results)) pools.push(j.results);\n  if (Array.isArray(j.data)) pools.push(j.data);\n  if (j.data && Array.isArray(j.data.results)) pools.push(j.data.results);\n  if (Array.isArray(j.organic)) pools.push(j.organic);\n  if (Array.isArray(j.news_results)) pools.push(j.news_results);\n  if (Array.isArray(j.items)) pools.push(j.items);\n  for (const arr of pools) {\n    for (const r of arr) {\n      if (!r || typeof r !== 'object') continue;\n      const title = String(r.title || r.name || '').trim();\n      const url = String(r.url || r.link || r.href || '').trim();\n      const snippet = String(r.snippet || r.description || r.content || r.summary || r.markdown || '').trim().slice(0, 280);\n      if (title || url) hits.push({ title, url, snippet });\n    }\n  }\n  return hits;\n}\nfunction safe(name) {\n  try { return $(name).first().json || {}; } catch (e) { return {}; }\n}\nconst cfg = $('Normalize Input').first().json || {};\nconst sources = [\n  'OmniRoute Brave Search',\n  'OmniRoute Firecrawl Search',\n  'Tavily Search QT',\n  'SerpAPI News QT',\n  'Jina Search QT',\n  'Firecrawl Direct QT',\n];\nconst seen = new Set();\nconst hits = [];\nfor (const name of sources) {\n  for (const h of extractHits(safe(name))) {\n    const key = (h.url || h.title).toLowerCase();\n    if (!key || seen.has(key)) continue;\n    seen.add(key);\n    hits.push(h);\n  }\n}\nconst cmc = safe('CMC Quotes QT');\nlet market = null;\ntry {\n  const d = (cmc.data || cmc);\n  market = {};\n  for (const sym of ['BTC','ETH','SOL']) {\n    const row = d[sym];\n    if (!row) continue;\n    const q = (row.quote && row.quote.USD) || {};\n    market[sym] = {\n      price: q.price,\n      change_24h: q.percent_change_24h,\n      market_cap: q.market_cap,\n    };\n  }\n  if (!Object.keys(market).length) market = null;\n} catch (e) { market = null; }\nconst max = cfg.max_results || 15;\nconst brief = hits.slice(0, max);\nconst model = cfg.mode === 'deep' ? (cfg.deep_model || 'auto/best-chat') : (cfg.triage_model || 'auto/fast');\nreturn [{ json: {\n  query: cfg.query, mode: cfg.mode, model, hit_count: brief.length, brief, market,\n}}];\n"
      },
