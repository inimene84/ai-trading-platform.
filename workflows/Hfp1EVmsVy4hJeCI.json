    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nconst system = `You are a crypto/markets research analyst. Given a query, a compact news brief (titles/urls/snippets), optional CMC spot context, and optional Scrapling page extract, return ONLY raw JSON (no markdown fences):\n{\"summary\":\"<2-4 sentences>\",\"bullets\":[\"...\"],\"sources\":[{\"title\":\"...\",\"url\":\"...\"}],\"confidence\":0.0,\"followups\":[\"...\"],\"market_note\":\"<one line or empty>\"}\nRules: ground claims in the brief/extract; if thin evidence, lower confidence and say so; prefer diverse sources; confidence is 0-1; market_note only if CMC context present.`;\nconst user = JSON.stringify({\n  query: j.query, mode: j.mode, model: j.model, hit_count: j.hit_count, brief: j.brief,\n  market: j.market || null,\n  scrapling: j.scrapling ? { url: j.scrapling.url, content: String(j.scrapling.content||\"\").slice(0,6000) } : null,\n});\nconst chat_payload = {\n  model: j.model || 'gemini-2.0-flash',\n  temperature: j.mode === 'deep' ? 0.2 : 0.35,\n  stream: false,\n  messages: [ { role: 'system', content: system }, { role: 'user', content: user } ],\n};\nreturn [{ json: { ...j, chat_payload } }];\n"
      },
