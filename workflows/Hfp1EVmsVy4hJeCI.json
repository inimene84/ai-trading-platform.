    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nlet content = '';\nif (j.choices && j.choices[0] && j.choices[0].message) {\n  content = String(j.choices[0].message.content || '');\n} else if (j.output) { content = String(j.output); }\nelse if (j.text) { content = String(j.text); }\nelse if (j.data && j.data.choices && j.data.choices[0] && j.data.choices[0].message) {\n  content = String(j.data.choices[0].message.content || '');\n}\nlet parsed = null;\ntry {\n  let txt = content.replace(/^```json\\s*/i, '').replace(/```$/i, '').trim();\n  const si = txt.indexOf('{');\n  const ei = txt.lastIndexOf('}');\n  if (si > -1 && ei > si) parsed = JSON.parse(txt.slice(si, ei + 1));\n} catch (e) {}\nconst prev = $('Build Chat Payload').first().json || {};\nconst result = parsed && typeof parsed === 'object' ? parsed : {\n  summary: content.slice(0, 2000) || 'No model content',\n  bullets: [],\n  sources: (prev.brief || []).slice(0, 5).map(h => ({ title: h.title, url: h.url })),\n  confidence: 0.2,\n  followups: [],\n  parse_error: true,\n};\nresult.meta = { query: prev.query, mode: prev.mode, model: prev.model, hit_count: prev.hit_count, workflow: '15-qt-omni-research' };\nreturn [{ json: result }];\n"
      },
