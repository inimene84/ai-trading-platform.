      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst query = String(body.query || body.topic || body.q || '').trim()\n  || 'bitcoin OR ethereum OR crypto OR blockchain news';\nconst mode = String(body.mode || 'auto').toLowerCase() === 'deep' ? 'deep' : 'auto';\nlet max_results = parseInt(body.max_results, 10);\nif (!Number.isFinite(max_results) || max_results < 1) max_results = 15;\nif (max_results > 25) max_results = 25;\nreturn [{ json: { query, mode, max_results, triage_model: 'auto/fast', deep_model: 'auto/best-chat' } }];\n"
