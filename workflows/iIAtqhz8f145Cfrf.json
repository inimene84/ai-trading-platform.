      "parameters": {
        "jsCode": "const j=$input.first().json||{};\nconst prev=$('Normalize Input').first().json||{};\nif(prev.ok===false) return [{json:{ok:false,error:prev.error,workflow:'17-qt-scrapling-fetch'}}];\nconst content=j.content;\nreturn [{json:{\n  ok: !j.error && typeof content==='string',\n  url: j.url || (prev.payload&&prev.payload.url),\n  status: j.status,\n  mode: j.mode,\n  extraction_type: j.extraction_type,\n  content: typeof content==='string'?content:null,\n  content_len: typeof content==='string'?content.length:0,\n  error: j.error||null,\n  workflow:'17-qt-scrapling-fetch',\n}}];"
