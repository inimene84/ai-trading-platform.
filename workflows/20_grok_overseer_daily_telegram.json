{
  "name": "20 - QuantumTrade GrokBOT Daily Overseer (Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 15,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a0a0a0a0-20aa-4000-8000-000000000001",
      "name": "Schedule 15:00 UTC (18:00 EEST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qt-grok-overseer-daily",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a0a0a0a0-20aa-4000-8000-000000000002",
      "name": "Webhook (on-demand)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 500],
      "webhookId": "qt-grok-overseer-daily"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ai-trading-backend:8000/api/agents/grok-overseer/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"focus\": \"daily risk, open FX book, sentry, and operational health\", \"include_positions\": true }",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a0a0a0a0-20aa-4000-8000-000000000003",
      "name": "HTTP: GrokBOT Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json || {};\nconst summary = String(body.summary || body.detail || body.error || 'Grok returned no summary');\nconst ov = body.overview || {};\nconst sec = ov.sections || {};\nconst health = sec.health || {};\nconst sentry = sec.sentry || {};\nconst loop = sec.loop || {};\nconst pos = sec.positions || {};\nconst ct = sec.ctrader || {};\n\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst now = new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC';\nconst equity = ct.equity ?? loop.equity ?? '?';\nconst npos = pos.count ?? ct.open_positions ?? '?';\nconst sentryStatus = sentry.status || sentry.trading_status || health.trading_status || '?';\n\nlet text = '<b>GrokBOT daily overseer</b>\\n<code>' + now + '</code>\\n\\n';\ntext += esc(summary).slice(0, 3200);\ntext += '\\n\\n<i>equity ' + esc(equity) + ' · positions ' + esc(npos) + ' · sentry ' + esc(sentryStatus) + '</i>';\nif (text.length > 4000) text = text.slice(0, 3990) + '…';\n\nreturn [{ json: { message: text, ok: Boolean(body.summary) } }];"
      },
      "id": "a0a0a0a0-20aa-4000-8000-000000000004",
      "name": "Format Telegram HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 400]
    },
    {
      "parameters": {
        "chatId": "6184893463",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "a0a0a0a0-20aa-4000-8000-000000000005",
      "name": "Telegram: Daily Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1000, 400],
      "credentials": {
        "telegramApi": {
          "id": "rl9H8K9VwXLloaiR",
          "name": "n8n"
        }
      }
    }
  ],
  "connections": {
    "Schedule 15:00 UTC (18:00 EEST)": {
      "main": [[{ "node": "HTTP: GrokBOT Analyze", "type": "main", "index": 0 }]]
    },
    "Webhook (on-demand)": {
      "main": [[{ "node": "HTTP: GrokBOT Analyze", "type": "main", "index": 0 }]]
    },
    "HTTP: GrokBOT Analyze": {
      "main": [[{ "node": "Format Telegram HTML", "type": "main", "index": 0 }]]
    },
    "Format Telegram HTML": {
      "main": [[{ "node": "Telegram: Daily Summary", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
