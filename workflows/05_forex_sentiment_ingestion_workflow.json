{
  "name": "05 Forex & Macro News Sentiment Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "url": "https://forexnewsapi.com/api/v1",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "items",
              "value": "50"
            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "token",
              "value": "={{$env.FOREXNEWSAPI_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-forex-news",
      "name": "Fetch Forex News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-980, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-articles",
      "name": "Split Articles",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-760, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.news_url}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-valid",
      "name": "Filter Valid Articles",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.0-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a forex market sentiment analyst. Given the news headline and text below, identify which currency pairs it is relevant to (use standard 6-letter forex codes like EURUSD, GBPJPY, XAUUSD - use XAUUSD for gold), and score sentiment for each pair from -1 (very bearish for base currency) to +1 (very bullish for base currency). Respond ONLY with valid JSON, no markdown, in this exact format: {\"pairs\": [{\"pair\": \"EURUSD\", \"sentiment\": \"bullish\", \"score\": 0.6, \"confidence\": 0.8, \"reasoning\": \"short reason\"}]}. If not relevant to any tradeable pair, respond {\"pairs\": []}.\n\nHeadline: {{$json.title}}\nText: {{$json.text}}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "score-sentiment-gemini",
      "name": "Score Sentiment (Gemini)",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [-320, 0],
      "credentials": {
        "googlePalmApi": {
          "id": "GEMINI_CRED_ID",
          "name": "Google Gemini account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  let parsed;\n  try {\n    const raw = item.json.content || item.json.text || item.json.message?.content || '';\n    const cleaned = raw.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    continue;\n  }\n  const pairs = parsed.pairs || [];\n  const parent = $('Filter Valid Articles').item.json;\n  items.push({\n    json: {\n      source: 'forexnewsapi',\n      external_id: parent.news_url,\n      title: parent.title,\n      description: parent.text,\n      url: parent.news_url,\n      published_at: parent.date,\n      scores: pairs.map(p => ({\n        pair: p.pair,\n        sentiment: p.sentiment,\n        score: p.score,\n        confidence: p.confidence,\n        reasoning: p.reasoning,\n        model: 'gemini-2.0-flash'\n      }))\n    }\n  });\n}\nreturn items;"
      },
      "id": "format-ingest-payload",
      "name": "Format Ingest Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_API_URL || 'http://backend:8000'}}/api/sentiment/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "id": "post-to-backend",
      "name": "Post to QuantumTrade Ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 0]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Forex News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Forex News": {
      "main": [
        [
          {
            "node": "Split Articles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Articles": {
      "main": [
        [
          {
            "node": "Filter Valid Articles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Valid Articles": {
      "main": [
        [
          {
            "node": "Score Sentiment (Gemini)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score Sentiment (Gemini)": {
      "main": [
        [
          {
            "node": "Format Ingest Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Ingest Payload": {
      "main": [
        [
          {
            "node": "Post to QuantumTrade Ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
