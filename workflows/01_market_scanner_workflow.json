{
  "name": "01 - QuantumTrade Market Scanner (5m Cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "1e9f06ab-7476-4be7-a25e-2b5e7d9b9f01",
      "name": "Schedule Trigger (5m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/signals/scan-markets",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"universe\": [\"EURUSD\", \"GBPUSD\", \"USDJPY\", \"AUDUSD\", \"USDCAD\", \"USDCHF\", \"NZDUSD\", \"EURGBP\", \"EURJPY\", \"GBPJPY\", \"EURAUD\", \"GBPAUD\", \"NZDJPY\", \"CHFJPY\", \"AUDJPY\", \"CADJPY\", \"XAUUSD\", \"XAGUSD\", \"BTCUSDT\", \"ETHUSDT\", \"SOLUSDT\"],\n  \"timeframe\": \"M5\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2c8d19ba-3521-4f9e-990a-1a8e6e5b4c02",
      "name": "HTTP: Scan Markets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.candidates_count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "3b7c28aa-4632-4e8f-881b-2b7e5e4d3b03",
      "name": "Candidates Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "4a6b37bb-5743-4f90-772c-3c6f4f3e2a04",
      "name": "Log Candidates to Console",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        220
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (5m)": {
      "main": [
        [
          {
            "node": "HTTP: Scan Markets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: Scan Markets": {
      "main": [
        [
          {
            "node": "Candidates Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Candidates Found?": {
      "main": [
        [
          {
            "node": "Log Candidates to Console",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
