    {
      "parameters": {
        "jsCode": "function extractHits(j) {\n  const hits = [];\n  const pools = [];\n  if (!j || typeof j !== 'object') return hits;\n  if (Array.isArray(j.results)) pools.push(j.results);\n  if (Array.isArray(j.data)) pools.push(j.data);\n  if (j.data && Array.isArray(j.data.results)) pools.push(j.data.results);\n  if (Array.isArray(j.organic)) pools.push(j.organic);\n  if (Array.isArray(j.news_results)) pools.push(j.news_results);\n  if (Array.isArray(j.items)) pools.push(j.items);\n  for (const arr of pools) {\n    for (const r of arr) {\n      if (!r || typeof r !== 'object') continue;\n      const title = String(r.title || r.name || '').trim();\n      const url = String(r.url || r.link || r.href || '').trim();\n      const snippet = String(r.snippet || r.description || r.content || r.markdown || '').trim().slice(0, 220);\n      if (title || url) hits.push({ title, url, snippet });\n    }\n  }\n  return hits;\n}\nfunction safe(name) {\n  try { return $(name).first().json || {}; } catch (e) { return {}; }\n}\nconst cfg = $('Default Crypto Query').first().json || {};\nconst sources = [\n  'OmniRoute Brave Search',\n  'OmniRoute Firecrawl Search',\n  'Tavily Search QT',\n  'SerpAPI News QT',\n  'Jina Search QT',\n  'Firecrawl Direct QT',\n];\nconst seen = new Set();\nconst hits = [];\nfor (const name of sources) {\n  for (const h of extractHits(safe(name))) {\n    const key = (h.url || h.title).toLowerCase();\n    if (!key || seen.has(key)) continue;\n    seen.add(key);\n    hits.push(h);\n  }\n}\nconst cmc = safe('CMC Quotes QT');\nlet market = null;\ntry {\n  const d = (cmc.data || cmc);\n  market = {};\n  for (const sym of ['BTC','ETH','SOL']) {\n    const row = d[sym];\n    if (!row) continue;\n    const q = (row.quote && row.quote.USD) || {};\n    market[sym] = { price: q.price, change_24h: q.percent_change_24h };\n  }\n  if (!Object.keys(market).length) market = null;\n} catch (e) { market = null; }\nconst top = hits.slice(0, cfg.max_results || 15);\nconst model = cfg.triage_model || 'auto/fast';\nconst system = `You are a crypto news triage desk. Classify headlines for short-horizon trading impact. Return ONLY raw JSON:\n{\"items\":[{\"title\":\"...\",\"url\":\"...\",\"impact\":\"high|med|low\",\"bias\":\"bull|bear|neutral\",\"reason\":\"<1 sentence>\"}],\"market_note\":\"<optional one-liner from CMC>\"}\nUse only provided headlines; skip empty titles; prefer high-signal market-moving items.`;\nconst chat_payload = {\n  model,\n  temperature: 0.25,\n  stream: false,\n  messages: [\n    { role: 'system', content: system },\n    { role: 'user', content: JSON.stringify({ query: cfg.query, headlines: top, market }) },\n  ],\n};\nreturn [{ json: { query: cfg.query, model, hit_count: top.length, headlines: top, market, chat_payload } }];\n"
      },
