    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nlet content = '';\nif (j.choices && j.choices[0] && j.choices[0].message) {\n  content = String(j.choices[0].message.content || '');\n} else if (j.output) { content = String(j.output); }\nelse if (j.text) { content = String(j.text); }\nelse if (j.data && j.data.choices && j.data.choices[0] && j.data.choices[0].message) {\n  content = String(j.data.choices[0].message.content || '');\n}\nlet parsed = null;\ntry {\n  let txt = content.replace(/^```json\\s*/i, '').replace(/```$/i, '').trim();\n  const si = txt.indexOf('{');\n  const ei = txt.lastIndexOf('}');\n  if (si > -1 && ei > si) parsed = JSON.parse(txt.slice(si, ei + 1));\n} catch (e) {}\nconst prev = $('Build Triage Payload').first().json || {};\nconst result = parsed && typeof parsed === 'object' ? parsed : { items: [], parse_error: true, raw: content.slice(0, 1500) };\nresult.meta = {\n  query: prev.query, model: prev.model, hit_count: prev.hit_count,\n  workflow: '16-qt-omni-news-triage', ingested_to_qt: false,\n  note: 'QT sentiment ingest skipped (no BACKEND_API_KEY invent)',\n};\nreturn [{ json: result }];\n"
