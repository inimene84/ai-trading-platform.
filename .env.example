# Copy to .env and fill secrets. Never commit .env.
# Grafana and dashboards should bind to localhost, not a public VPS IP.

XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4-1-fast-reasoning
OLLAMA_ENABLED=false
XAI_BASE_URL=https://api.x.ai/v1
KIE_API_KEY=your_kie_api_key_here
KIE_MODEL=gpt-5-6-terra
KIE_BASE_URL=https://api.kie.ai
PERSONA_LLM_PROVIDER=kie
DEEP_ANALYSIS_LLM_PROVIDER=kie
GENERAL_LLM_PROVIDER=kie
LITELLM_API_KEY=
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

MACRO_LOOP_ENABLED=true
MACRO_LOOP_INTERVAL_MIN=60
GRAFANA_URL=http://localhost:8081/grafana

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMENSIONS=1536
MARKET_ALERTS_ENABLED=true
FEED_SCHEDULER_ENABLED=true

DRY_RUN_ALL=true
TRADING_MODE=paper
PAPER_TRADING=true
PAPER_BALANCE=100000
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

CTRADER_ENV=demo
CTRADER_PAPER_MODE=true
CTRADER_LIVE_CONFIRM=
FX_KRONOS_GATE=enforce

ADMIN_API_KEY=
QDRANT_API_KEY=
CONFIRM_LIVE_DEPLOY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

INFLUXDB_URL=http://vps-influxdb:8086
INFLUXDB_TOKEN=
INFLUXDB_ADMIN_PASSWORD=change-me-strong-password
KRONOS_SIDECAR_URL=http://kronos-infer:8001
KRONOS_ALLOW_LOCAL_STUB=false
TIMING_GATE_SHADOW=true
