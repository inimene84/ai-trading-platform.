# Copy this file to .env and fill in real secrets. Never commit .env.
# Grafana and other UIs should bind to localhost, not a public VPS IP.

# ── AI Brain (LLM Engine) ───────────────────────────────────
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4-1-fast-reasoning
OLLAMA_ENABLED=false
XAI_BASE_URL=https://api.x.ai/v1

KIE_API_KEY=your_kie_api_key_here
KIE_MODEL=gpt-5-6-terra
KIE_BASE_URL=https://api.kie.ai

PERSONA_LLM_PROVIDER=kie
DEEP_ANALYSIS_LLM_PROVIDER=kie
GENERAL_LLM_PROVIDER=kie

LITELLM_API_KEY=
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LITERT_MODEL_PATH=
LITERT_MAX_TOKENS=4096
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ── Market Data ───────────────────────────────────────────
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=
NEWSAPI_KEY=
