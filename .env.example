KRONOS_BATCH_CRON="*/30 * * * *"

LUNARCRUSH_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=hedge-fund-bot/1.0

# ── Execution ────────────────────────────────────────────
DRY_RUN_ALL=true
